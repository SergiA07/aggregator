# ===========================================
# Portfolio Aggregator - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control!

# ===========================================
# Database (Required)
# ===========================================
# PostgreSQL connection string
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ===========================================
# Supabase Auth (Required in production)
# ===========================================
# Get these from your Supabase project dashboard > Settings > API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here

# ===========================================
# API Server
# ===========================================
NODE_ENV=development
PORT=3333

# Frontend URL for CORS (required in production)
FRONTEND_URL=http://localhost:5173

# ===========================================
# Python Service
# ===========================================
# URL where the Python service is running
PYTHON_SERVICE_URL=http://localhost:8000

# API key for service-to-service authentication (REQUIRED)
# Generate a secure random key: openssl rand -hex 32
PYTHON_SERVICE_API_KEY=your-secure-api-key-here

# ===========================================
# Development Only
# ===========================================
# Bypass auth for local development (NEVER use in production)
AUTH_DEV_BYPASS=false

# Python service environment (controls logging level)
ENV=development

# Price Data (Optional)
# Finnhub API key for US stock prices - get one at https://finnhub.io/
# Free tier: 60 requests/minute. If not set, falls back to Yahoo Finance.
FINNHUB_API_KEY=""

